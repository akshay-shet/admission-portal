{
  "name": "student-portal-hostinger",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Student Portal for Hostinger VPS: React front end + Node.js backend + PostgreSQL",
  "engines": { "node": ">=20" },
  "scripts": {
    "install:all": "npm install && npm --prefix frontend install",
    "build:frontend": "npm --prefix frontend run build",
    "db:setup": "node connectivity/database/setup.js",
    "db:import": "node backend/import.js",
    "reset-login": "node backend/reset-login.js",
    "start": "node backend/server.js"
  },
  "dependencies": {
    "express": "4.22.3",
    "pg": "8.23.1"
  }
}
