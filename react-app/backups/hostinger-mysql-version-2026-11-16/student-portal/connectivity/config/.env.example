# ============================================================================
#  Student Portal — server settings. Copy this file to .env (same folder) and fill it in.
#  Never upload .env to GitHub or share it: it holds the database password.
# ============================================================================

# ---- MySQL (create the database + user first: README-HOSTINGER.md step 3) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=student_portal
DB_USER=portal
DB_PASSWORD=CHANGE_ME
# DB_SSL=1            # only if your MySQL server requires an encrypted connection

# ---- Web server ----
PORT=3000
HOST=127.0.0.1        # nginx forwards the public site to this port
NODE_ENV=production
TRUST_PROXY=1         # behind nginx: real visitor IP for the wrong-password limit
FORCE_HTTPS=1         # send http:// visitors to https://
SESSION_HOURS=12      # a sign-in lasts at most this long
# SESSION_SECRET=     # leave empty: a random secret is created in connectivity/config/.secret

# ---- First logins (used once, when `npm run db:setup` finds an empty database) ----
# Same as the portal today unless you change them here. CHANGE THEM after the first sign-in.
FIRST_OWNER_USER=admin
FIRST_OWNER_PASSWORD=admin
FIRST_EMPLOYEE_USER=employee
FIRST_EMPLOYEE_PASSWORD=employee

# ---- Google Sheet link (service account) ----
# Path of the service-account key file (JSON from Google Cloud), relative to the project folder.
# Keep it OUTSIDE frontend/. Share the spreadsheet with the service account's email as Editor.
GOOGLE_SERVICE_ACCOUNT_FILE=connectivity/google-sheets/service-account.json
GOOGLE_SHEET_ID=1Uw1euENvPMZfJx7Qg89ZMu9ew208uCkiWNl24W4BWh0

# ---- Folders (relative to the project folder) ----
FRONTEND_DIST=frontend/dist
BACKUP_DIR=backups
