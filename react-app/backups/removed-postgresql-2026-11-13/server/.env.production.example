# ---- Student Portal on a host (copy to server/.env on the server; never upload your PC's .env) ----
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
# PostgreSQL on the same VPS (recommended) — use a NEW strong password, not your PC password
DATABASE_URL=postgres://portal_app:CHANGE_THIS_LONG_PASSWORD@127.0.0.1:5432/student_portal
# a hosted/managed PostgreSQL: add  ?sslmode=require  to DATABASE_URL (or PGSSLMODE=require)
# long random secret that signs logins (make one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_VALUE
# the site runs behind nginx / Hostinger's proxy: real visitor addresses + https only
TRUST_PROXY=1
FORCE_HTTPS=1
# FIRST sign-in only (Owner Login, username admin + this password). Remove this line after you set your own owner login.
FIRST_OWNER_PASSWORD=CHANGE_THIS_ONE_TIME_PASSWORD
# how long a sign-in lasts (hours)
SESSION_HOURS=10
