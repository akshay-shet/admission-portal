# Copy this file to "server/.env" and fill in your PostgreSQL password.
# Either one connection string (a password with @ : # / in it is fine) …
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/student_portal
# … or the separate values (used only when DATABASE_URL is empty)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=YOUR_PASSWORD
# PGDATABASE=student_portal

# Web address of the portal: http://localhost:3000
PORT=3000
# Leave empty: a random secret is created in server/.secret on first start
SESSION_SECRET=
